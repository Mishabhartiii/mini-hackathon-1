#include <stdio.h>

#define MAX 5

char vehicle[MAX][20];
int status[MAX] = {0};

int main()
{
    int choice, i, hours, fee;
    char number[20];

    do
    {
        printf("\n--- SMART CAMPUS PARKING ---\n");
        printf("1. Vehicle Entry\n");
        printf("2. Vehicle Exit\n");
        printf("3. Available Slots\n");
        printf("4. Display Vehicles\n");
        printf("5. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter vehicle number: ");
                scanf("%19s", number);

                for(i = 0; i < MAX; i++)
                {
                    if(status[i] == 1)
                    {
                        int j = 0;

                        while(vehicle[i][j] == number[j] &&
                              vehicle[i][j] != '\0')
                            j++;

                        if(vehicle[i][j] == number[j])
                            break;
                    }
                }

                if(i < MAX)
                    printf("Vehicle already parked!\n");
                else
                {
                    for(i = 0; i < MAX; i++)
                    {
                        if(status[i] == 0)
                            break;
                    }

                    if(i == MAX)
                        printf("Parking Full!\n");
                    else
                    {
                        int j = 0;

                        while(number[j] != '\0')
                        {
                            vehicle[i][j] = number[j];
                            j++;
                        }

                        vehicle[i][j] = '\0';
                        status[i] = 1;

                        printf("Vehicle parked in Slot %d\n", i + 1);
                    }
                }
                break;

            case 2:
                printf("Enter vehicle number: ");
                scanf("%19s", number);

                for(i = 0; i < MAX; i++)
                {
                    int j = 0;

                    while(status[i] == 1 &&
                          vehicle[i][j] == number[j] &&
                          vehicle[i][j] != '\0')
                        j++;

                    if(status[i] == 1 &&
                       vehicle[i][j] == number[j])
                        break;
                }

                if(i == MAX)
                    printf("Vehicle not found!\n");
                else
                {
                    printf("Enter parking hours: ");
                    scanf("%d", &hours);

                    if(hours <= 0)
                        printf("Invalid hours!\n");
                    else
                    {
                        fee = hours * 20;

                        printf("Total Parking Fee: Rs. %d\n", fee);

                        status[i] = 0;
                        vehicle[i][0] = '\0';

                        printf("Slot released!\n");
                    }
                }
                break;

            case 3:
                for(i = 0; i < MAX; i++)
                {
                    if(status[i] == 0)
                        printf("Slot %d: Available\n", i + 1);
                }
                break;

            case 4:
                for(i = 0; i < MAX; i++)
                {
                    if(status[i] == 1)
                        printf("Slot %d: %s\n", i + 1, vehicle[i]);
                }
                break;

            case 5:
                printf("Thank You!\n");
                break;

            default:
                printf("Invalid Choice!\n");
        }

    } while(choice != 5);

    return 0;
}
